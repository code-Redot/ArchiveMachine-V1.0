# --- build outputs ---
/target/
/build/
/dist/
/out/
*.class

# --- IDE / tool state (often contains absolute paths and personal config) ---
.idea/
*.iml
.vscode/
.claude/
.gradle/

# --- OS junk ---
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# --- editor backup / merge artifacts ---
*.bak
*.orig
*.rej
*.swp
*.swo
*~

# --- JVM crash dumps and arbitrary logs (may leak paths/usernames) ---
hs_err_pid*.log
replay_pid*.log
*.log

# --- secrets / credentials (defense in depth; nothing here should ever ship) ---
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*

# --- Bundled 7-Zip installer (drop locally before build; not ours to redistribute) ---
src/main/resources/installers/7z-installer.exe
